<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.mainapp.controller.departement.DepartmentController"
      spacing="20" styleClass="page-content">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Gestion des départements" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="200"/>
        <Button text="+ Ajouter" onAction="#handleAddDepartment" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="departmentTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

        <columns>
            <TableColumn fx:id="colDeptId" text="ID" prefWidth="280"/>
            <TableColumn fx:id="colDeptNom" text="Nom du Département" prefWidth="250"/>
            <TableColumn fx:id="colDeptNbEmp" text="Effectif (Nb Employés)" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>