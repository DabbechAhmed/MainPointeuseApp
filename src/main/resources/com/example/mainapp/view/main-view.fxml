<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.mainapp.controller.MainController"
            stylesheets="@style.css" styleClass="root">

    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-title-container">
                <Label text="Menu latéral" styleClass="sidebar-title"/>
            </VBox>

            <Button text="Dashboard" onAction="#showDashboard" styleClass="menu-button"/>
            <Button text="Employés" onAction="#showEmployees" styleClass="menu-button"/>
            <Button text="Départements" onAction="#showDepartments" styleClass="menu-button"/>
            <Button text="Pointages" onAction="#showPointages" styleClass="menu-button"/>

            <Region VBox.vgrow="ALWAYS" />

            <Button text="⚙️ Paramètres" onAction="#showSettings" styleClass="menu-button"/>
            <Label fx:id="statusLabel" text="Prêt" style="-fx-text-fill: #888888; -fx-padding: 20;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="page-container">

            <VBox fx:id="viewDashboard" spacing="30" visible="true">
                <Label text="Application de Pointage - Polytech Tours" styleClass="header-title" maxWidth="Infinity"/>
                <Label text="Résumé Quotidien" styleClass="section-title"/>
                <HBox spacing="30">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="Nombre d'employés" styleClass="stat-title"/>
                        <Label fx:id="employeeCountLabel" text="0" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="Pointages aujourd'hui" styleClass="stat-title"/>
                        <Label text="-" styleClass="stat-number"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="Incidents détectés" styleClass="stat-title"/>
                        <Label text="-" styleClass="stat-number"/>
                    </VBox>
                </HBox>
            </VBox>

            <fx:include source="employee-view.fxml" fx:id="viewEmployees" visible="false" />

            <fx:include source="department-view.fxml" fx:id="viewDepartments" visible="false" />

            <VBox fx:id="viewPointages" spacing="20" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label text="Historique des pointages" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Filtrer par date:"/>
                    <DatePicker fx:id="dateFilter"/>
                    <Button text="Appliquer" onAction="#handleFilterAttendance" styleClass="btn-primary"/>
                </HBox>

                <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAttEmpId" text="ID Employé" prefWidth="100"/>
                        <TableColumn fx:id="colAttEmpNom" text="Nom Employé" prefWidth="150"/>
                        <TableColumn fx:id="colAttType" text="Type (In/Out)" prefWidth="100"/>
                        <TableColumn fx:id="colAttDate" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colAttHeure" text="Heure Pointage" prefWidth="150"/>
                        <TableColumn fx:id="colAttStatut" text="Statut" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="viewSettings" spacing="20" visible="false">
                <Label text="Paramètres de l'application (F5)" styleClass="section-title"/>

                <GridPane hgap="15" vgap="15">
                    <Label text="Port d'écoute TCP :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="serverPortField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="ex: 8080" />

                    <Label text="Tolérance Retard/Avance (minutes) :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="toleranceField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="ex: 15" />
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Button text="Sauvegarder" onAction="#handleSaveSettings" styleClass="btn-primary"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>