<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.mainapp.controller.attendance.AttendanceController"
      spacing="20" styleClass="page-content">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Historique des pointages" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Filtrer par date:"/>
        <DatePicker fx:id="dateFilter"/>
        <Button text="Appliquer" onAction="#handleFilterAttendance" styleClass="btn-secondary"/>
        <Button text="+ Add new" onAction="#handleAddAttendance" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colAttEmpId" text="ID Employé" prefWidth="100"/>
            <TableColumn fx:id="colAttEmpNom" text="Nom Employé" prefWidth="150"/>
            <TableColumn fx:id="colAttType" text="Type (In/Out)" prefWidth="100"/>
            <TableColumn fx:id="colAttDate" text="Date" prefWidth="120"/>
            <TableColumn fx:id="colAttHeure" text="Heure Pointage" prefWidth="150"/>
            <TableColumn fx:id="colAttStatut" text="Statut" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>